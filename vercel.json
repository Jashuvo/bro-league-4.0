{
  "functions": {
    "api/bootstrap.js": {
      "maxDuration": 30
    },
    "api/league.js": {
      "maxDuration": 30
    },
    "api/manager-history.js": {
      "maxDuration": 30
    },
    "api/team-picks.js": {
      "maxDuration": 30
    },
    "api/fixtures.js": {
      "maxDuration": 30
    },
    "api/league-complete.js": {
      "maxDuration": 60
    },
    "api/live-stats.js": {
      "maxDuration": 60
    },
    "api/warm-cache.js": {
      "maxDuration": 60
    },
    "api/season-archive.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    { "path": "/api/warm-cache", "schedule": "0 6 * * *" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    }
  ]
}