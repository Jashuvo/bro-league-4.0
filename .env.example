# ── League identity ─────────────────────────────────────────────────────────
# This season's FPL classic-league ID. No fallback on purpose — unset it and
# the app fails loudly instead of silently showing a stale league.
VITE_FPL_LEAGUE_ID=
VITE_LEAGUE_NAME="BRO League 5"
VITE_ENTRY_FEE=800
VITE_TOTAL_PRIZE_POOL=

# Bump by hand every rollover, alongside leagueConfig.season in
# src/data/leagueData.js — used to tag rows written into season_archive.
VITE_SEASON="2026/27"

# ── Supabase (cache, season archive, exclusions, push subscriptions) ────────
# VITE_ values are safe for the browser (RLS applies). The service-role key
# is SERVER-ONLY — never prefix it with VITE_, never commit it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── Cron + writes ───────────────────────────────────────────────────────────
# Vercel signs cron-triggered requests with this automatically once it's set.
# Without it, warm-cache accepts unsigned requests.
CRON_SECRET=
# Gates writes (exclude/restore a manager) to the shared exclusion list.
EXCLUSION_PIN=

# ── Web push (matchday alerts) ──────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Both keys must be set or the whole notifications feature hides itself.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service, e.g. mailto:you@example.com
VAPID_SUBJECT=

# ── Client-only extras (optional) ───────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_DEV_MODE=
